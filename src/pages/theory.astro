---
import { HeaderNav } from '../components/HeaderNav';
import { GuideContent } from '../components/GuideContent';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>キャリア理論解説 - キャリアすごろく</title>
    <meta name="description" content="キャリアすごろくのバックグラウンドにある学術理論（ホランドのRIASEC、サニーハンセンの4L理論、クランボルツの計画的偶発性理論、厚労省ポータブルスキル）の解説。" />
  </head>
  <body className="min-h-screen bg-slate-950 text-slate-100 font-sans">
    <HeaderNav client:only="react" activeTab="theory" />
    <main className="px-4 max-w-7xl mx-auto">
      <GuideContent client:only="react" initialTab="theory" />
    </main>
  </body>
</html>
