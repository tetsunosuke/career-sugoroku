---
import { HeaderNav } from '../components/HeaderNav';
import { GuideContent } from '../components/GuideContent';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>キャリア理論解説 - キャリア・キルト・クエスト</title>
    <meta name="description" content="キャリア・キルト・クエストのバックグラウンドにある学術理論（キャリア・キルト概念、サニーハンセン4L理論、自己決定理論、プロティアン・キャリア、クランボルツ計画的偶発性理論）の解説。" />
  </head>
  <body className="min-h-screen bg-slate-950 text-slate-100 font-sans">
    <HeaderNav client:only="react" activeTab="theory" />
    <main className="px-4 max-w-7xl mx-auto">
      <GuideContent client:only="react" initialTab="theory" />
    </main>
  </body>
</html>
